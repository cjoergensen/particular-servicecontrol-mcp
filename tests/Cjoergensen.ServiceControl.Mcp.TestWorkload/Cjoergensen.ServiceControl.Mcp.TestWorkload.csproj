<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A small NServiceBus system that produces real data for ServiceControl: failing messages, heartbeats, custom checks,
    saga audit, audited messages and metrics. It exists only to test the MCP server end to end and is never packaged or shipped.
    NServiceBus is licensed separately (RPL 1.5 / commercial); that dependency is deliberately confined to this test project.
  -->
  <PropertyGroup>
    <RootNamespace>Cjoergensen.ServiceControl.Mcp.TestWorkload</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="NServiceBus" />
    <PackageReference Include="NServiceBus.RabbitMQ" />
    <PackageReference Include="NServiceBus.Heartbeat" />
    <PackageReference Include="NServiceBus.CustomChecks" />
    <PackageReference Include="NServiceBus.SagaAudit" />
    <PackageReference Include="NServiceBus.Metrics.ServiceControl" />
  </ItemGroup>

</Project>
