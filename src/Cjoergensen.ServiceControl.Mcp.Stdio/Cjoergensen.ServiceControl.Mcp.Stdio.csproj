<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Cjoergensen.ServiceControl.Mcp.Stdio</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>servicecontrol-mcp</ToolCommandName>
    <PackageId>Cjoergensen.ServiceControl.Mcp</PackageId>
    <Description>Unofficial MCP server (stdio) that lets AI agents query and act on Particular ServiceControl: failed messages, heartbeats, custom checks, sagas and monitoring.</Description>
    <PackageTags>mcp;servicecontrol;particular;nservicebus;ai</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <ProjectReference Include="..\Cjoergensen.ServiceControl.Mcp.Core\Cjoergensen.ServiceControl.Mcp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Condition="Exists('..\..\README.md')" />
  </ItemGroup>

</Project>
